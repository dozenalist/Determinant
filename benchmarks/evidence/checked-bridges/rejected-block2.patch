+theorem checkNatRows_append {upper : Bool} {n p i : ℕ}
+    {rows tail bt : List (List ℕ)}
+    (hr : checkNatRows upper n p i rows bt = true)
+    (ht : checkNatRows upper n p (i + rows.length) tail bt = true) :
+    checkNatRows upper n p i (rows ++ tail) bt = true := by
+  simpa only [checkNatRows, List.zipIdx_append, List.all_append,
+    Bool.and_eq_true] using And.intro hr ht
+
 theorem checkNat_entry {upper : Bool} {n p : ℕ} {a bt : List (List ℕ)}
     (ha : a.length = n) (hw : a.all (fun row => row.length == n) = true)
     (ht : bt.length = n) (h : checkNat upper n p a bt = true)
