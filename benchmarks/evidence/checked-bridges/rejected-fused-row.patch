+def checkNatRowFrom (upper : Bool) (p i : ℕ) (row : List ℕ) :
+    ℕ → List (List ℕ) → Bool
+  | _, [] => true
+  | j, col :: cols =>
+    (if upper && i < j then true
+     else natDotFused row col % p == if i == j then 1 else 0) &&
+      checkNatRowFrom upper p i row (j + 1) cols
+
+theorem checkNatRowFrom_eq (upper : Bool) (p i : ℕ) (row : List ℕ)
+    (j : ℕ) (bt : List (List ℕ)) :
+    checkNatRowFrom upper p i row j bt = (bt.zipIdx j).all (fun (col, k) =>
+      if upper && i < k then true
+      else natDotFused row col % p == if i == k then 1 else 0) := by
+  induction bt generalizing j with
+  | nil => rfl
+  | cons col cols ih =>
+    simp only [checkNatRowFrom, List.zipIdx_cons, List.all_cons, ih]
+
